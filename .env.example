# Required
TELEGRAM_BOT_TOKEN=
BIOHUB_API_TOKEN=
BOLTZ_API_KEY=

# Optional: restrict the bot to a single Telegram user id
TELEGRAM_ALLOWED_USER_ID=

# Optional overrides (defaults match official docs)
# BIOHUB_URL=https://biohub.ai
# BOLTZ_BASE_URL=https://api.boltz.bio
# MAX_SEQUENCE_LENGTH=800

# Optional: pre-GPU biosecurity screen (fail-closed if missing)
# COMMEC_BIN=commec
# COMMEC_TIMEOUT_SEC=60

# Optional: /scribe OpenAI-compatible chat completions (fail-closed if unset)
# SCRIBE_LLM_URL=
# SCRIBE_LLM_KEY=
# SCRIBE_LLM_MODEL=

# Optional: /bind BindCraft (fail-closed if unset; needs GPU + AF2 weights)
# BINDCRAFT_HOME=
# BINDCRAFT_TIMEOUT_SEC=

# Optional: Modal GPU for /design binder (compute-only; never send clinic/secrets)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_BINDCRAFT_APP=

# Optional: /app live-view TTL host (Cloudflare Pages/Workers or Vercel). Fail-closed if unset.
# /app live view — R2 SigV4 (works on this host) OR generic Bearer Worker
# APP_DEPLOY_PROVIDER=r2
# APP_DEPLOY_BASE_URL=https://pub-….r2.dev
# APP_DEPLOY_BUCKET=kitchen-cook
# APP_DEPLOY_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# APP_DEPLOY_SIGNING_SECRET=
# APP_DEPLOY_TTL_DAYS=7
# --- or Path A Worker ---
# APP_DEPLOY_PROVIDER=generic
# APP_DEPLOY_TOKEN=
# APP_DEPLOY_BASE_URL=https://pub-….r2.dev
# APP_DEPLOY_PUT_URL=https://cook-app-views.<subdomain>.workers.dev/objects/{slug}.html
# APP_DEPLOY_DELETE_URL=https://cook-app-views.<subdomain>.workers.dev/objects/{slug}.html
# APP_DEPLOY_SIGNING_SECRET=
# APP_DEPLOY_TTL_DAYS=7
